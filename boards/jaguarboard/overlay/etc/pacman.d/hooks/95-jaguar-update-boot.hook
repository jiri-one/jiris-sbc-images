# Match mkinitcpio's install/remove triggers and the systemd-boot binaries.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/lib/systemd/systemd-udevd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm
Target = usr/bin/mdadm
Target = usr/bin/pdata_tools
Target = usr/lib/libcryptsetup.so
Target = usr/lib/libp11-kit.so
Target = usr/lib/libpcsclite.so
Target = usr/lib/modprobe.d/
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/systemd/boot/efi/systemd-bootia32.efi
Target = usr/lib/systemd/boot/efi/systemd-bootx64.efi

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = mkinitcpio
Target = mkinitcpio-git

[Action]
Description = Updating JaguarBoard systemd-boot files on /boot/efi...
When = PostTransaction
Exec = /usr/local/sbin/jaguar-update-boot
