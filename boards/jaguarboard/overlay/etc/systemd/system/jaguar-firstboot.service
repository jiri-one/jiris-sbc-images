[Unit]
Description=Initialize the JaguarBoard per-device package keyring
After=local-fs.target systemd-random-seed.service
ConditionPathExists=!/var/lib/jaguarboard/initialized

[Service]
Type=oneshot
ExecCondition=/usr/bin/test -e /run/systemd/timesync/synchronized
ExecStart=/usr/local/sbin/jaguar-firstboot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
