[Unit]
Description=Initialize the ODROID-M1S image's per-device package keyring
After=local-fs.target systemd-random-seed.service
ConditionPathExists=!/var/lib/odroid-m1s/initialized

[Service]
Type=oneshot
# Skip cleanly while offline; the timer retries without delaying SSH.
ExecCondition=/usr/bin/test -e /run/systemd/timesync/synchronized
ExecStart=/usr/local/sbin/odroid-m1s-firstboot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
