#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run as root.' >&2; exit 1; }
if [[ ${M1S_IMAGE_BUILD:-0} == 1 && ! -f /etc/odroid-m1s-image.conf ]]; then
    echo 'No image configuration yet; boot files will be prepared by the image builder.'
    exit 0
fi
# Serialize manual refreshes and package hooks through selection and cleanup.
mkdir -p /run/lock
exec 9>/run/lock/odroid-m1s-update-boot.lock
flock -x 9
/usr/local/sbin/odroid-m1s-check-boot
# This file is generated by the builder and owned by root.
# shellcheck source=/dev/null
source /etc/odroid-m1s-image.conf
[[ $ROOT_PARTUUID =~ ^[0-9a-f-]{36}$ ]]
if [[ ${M1S_IMAGE_BUILD:-0} != 1 ]]; then
    mountpoint -q /boot || { echo '/boot is not mounted; refusing to update boot files.' >&2; exit 1; }
    actual_uuid=$(findmnt -n -o UUID --target /boot)
    [[ $actual_uuid == "$BOOT_FS_UUID" ]] || { echo 'Unexpected /boot filesystem UUID.' >&2; exit 1; }
fi
kernel_list=$(pacman -Qql linux | sed -n '\|^/usr/lib/modules/[^/]*/vmlinuz$|p')
[[ -n $kernel_list ]] || { echo 'No package-owned kernel found.' >&2; exit 1; }
mapfile -t kernels <<< "$kernel_list"
[[ ${#kernels[@]} -eq 1 ]] || { echo 'Expected exactly one package-owned kernel.' >&2; exit 1; }
kernel=${kernels[0]}
kver=$(basename "$(dirname "$kernel")")
[[ $kver =~ ^[0-9A-Za-z._+-]+$ ]]
dtb="/usr/lib/modules/$kver/dtb/rockchip/rk3566-odroid-m1s.dtb"
[[ -s $dtb ]] || { echo 'Matching DTB missing.' >&2; exit 1; }
previous=''
existing_previous=''
if [[ -f /boot/extlinux/extlinux.conf ]]; then
    previous=$(awk '$1 == "LINUX" && $2 ~ /^\/odroid\// {split($2,p,"/"); print p[3]; exit}' /boot/extlinux/extlinux.conf)
    [[ $previous =~ ^[0-9A-Za-z._+-]+$ ]] || previous=''
    existing_previous=$(awk '$1 == "LABEL" {label=$2} label == "previous" && $1 == "LINUX" {split($2,p,"/"); print p[3]; exit}' /boot/extlinux/extlinux.conf)
    [[ $existing_previous =~ ^[0-9A-Za-z._+-]+$ ]] || existing_previous=''
fi
mkdir -p /boot/odroid /boot/extlinux
# A killed updater cannot run its EXIT trap. With the lock held, reclaim only
# real directories with our generated staging name, never links or boot sets.
for directory in /boot/odroid/.*; do
    [[ -d $directory && ! -L $directory ]] || continue
    name=${directory##*/}
    [[ $name =~ ^\.[0-9A-Za-z._+-]+\.[0-9A-Za-z]{6}$ ]] || continue
    rm -rf -- "$directory"
done
staging=$(mktemp -d "/boot/odroid/.${kver}.XXXXXX")
trap 'rm -rf -- "$staging"' EXIT
python /usr/local/lib/odroid-m1s/extract-kernel.py "$kernel" "$staging/Image"
install -m 644 "$dtb" "$staging/rk3566-odroid-m1s.dtb"
if [[ ${M1S_IMAGE_BUILD:-0} == 1 ]]; then
    [[ -s /boot/initramfs-linux.img ]] || {
        echo 'The image-builder initramfs is missing or empty.' >&2
        exit 1
    }
    [[ $(cat /usr/share/odroid-m1s/initramfs-kernel) == "$kver" ]] || {
        echo 'The image-builder initramfs does not match the installed kernel.' >&2
        exit 1
    }
    install -m 644 /boot/initramfs-linux.img "$staging/initramfs-linux.img"
else
    # A failed earlier pacman hook must never promote an incomplete initramfs.
    # Generate the exact kernel's image here and require a successful result.
    mkinitcpio -k "$kver" -g "$staging/initramfs-linux.img"
    chmod 644 "$staging/initramfs-linux.img"
fi
printf '%s\n' "$kver" > "$staging/kernel-version"
sync -f "$staging"
boot_digest=$(cd "$staging" && sha256sum Image rk3566-odroid-m1s.dtb initramfs-linux.img | sha256sum | cut -d ' ' -f 1)
release="$kver-${boot_digest:0:32}"
if [[ $previous == "$release" ]]; then
    previous=$existing_previous
fi
# Content-addressed directories are immutable. Refuse to reuse damaged files.
if [[ -e /boot/odroid/$release || -L /boot/odroid/$release ]]; then
    if [[ ! -d /boot/odroid/$release || -L /boot/odroid/$release ]]; then
        echo 'Existing boot set is damaged; the selected entry was not changed.' >&2
        exit 1
    fi
    for file in Image rk3566-odroid-m1s.dtb initramfs-linux.img kernel-version; do
        if [[ ! -f /boot/odroid/$release/$file || -L /boot/odroid/$release/$file ]] ||
            ! cmp -s "$staging/$file" "/boot/odroid/$release/$file"; then
            echo 'Existing boot set is damaged; the selected entry was not changed.' >&2
            exit 1
        fi
    done
    rm -rf -- "$staging"
else
    mv "$staging" "/boot/odroid/$release"
fi
config=$(mktemp /boot/extlinux/.extlinux.conf.XXXXXX)
entry() {
    local label=$1 version=$2 title=$3
    cat <<EOF

LABEL $label
    MENU LABEL $title
    LINUX /odroid/$version/Image
    INITRD /odroid/$version/initramfs-linux.img
    FDT /odroid/$version/rk3566-odroid-m1s.dtb
    APPEND root=PARTUUID=$ROOT_PARTUUID rw rootwait console=ttyS2,1500000 console=tty1 systemd.show_status=yes
EOF
}
{
    printf 'DEFAULT arch\nTIMEOUT 30\nMENU TITLE Arch Linux Ports - ODROID M1S\n'
    entry arch "$release" "Arch Linux Ports ($kver)"
    if [[ -n $previous && $previous != "$release" && -f /boot/odroid/$previous/Image ]]; then
        entry previous "$previous" "Previous kernel ($previous)"
    fi
} > "$config"
chmod 644 "$config"
sync -f "$config"
mv "$config" /boot/extlinux/extlinux.conf
sync -f /boot/extlinux
for directory in /boot/odroid/*; do
    [[ -d $directory ]] || continue
    name=$(basename "$directory")
    if [[ $name != "$release" && $name != "$previous" ]]; then
        rm -rf -- "$directory"
    fi
done
printf 'Boot files ready for kernel %s.\n' "$kver"
