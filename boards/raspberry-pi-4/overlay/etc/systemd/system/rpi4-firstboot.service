[Unit]
Description=Initialize the Raspberry Pi 4 image's per-device package keyring
After=local-fs.target systemd-random-seed.service
ConditionPathExists=!/var/lib/rpi4/initialized

[Service]
Type=oneshot
# Skip cleanly while offline; the timer retries without delaying SSH.
ExecCondition=/usr/bin/test -e /run/systemd/timesync/synchronized
ExecStart=/usr/local/sbin/rpi4-firstboot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
