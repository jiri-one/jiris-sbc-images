[Unit]
Description=Retry Raspberry Pi 4 package keyring initialization after time synchronization
ConditionPathExists=!/var/lib/rpi4/initialized

[Timer]
# Monotonic deadlines remain valid when NTP corrects an invalid RTC date.
OnBootSec=30s
OnUnitInactiveSec=60s
AccuracySec=1s

[Install]
WantedBy=timers.target
