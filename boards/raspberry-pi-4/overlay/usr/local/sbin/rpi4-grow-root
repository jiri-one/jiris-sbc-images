#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source /etc/rpi4-image.conf
root_device=$(readlink -f "$(findmnt -n -o SOURCE /)")
root_type=$(findmnt -n -o FSTYPE /)
root_partuuid=$(blkid -s PARTUUID -o value "$root_device")
partition=$(lsblk -dn -o PARTN "$root_device" | tr -d ' ')
parent=$(lsblk -dn -o PKNAME "$root_device" | tr -d ' ')
# ROOT_PARTUUID is assigned by the root-owned image configuration above.
# shellcheck disable=SC2153
[[ $root_type == ext4 && ${root_partuuid,,} == "${ROOT_PARTUUID,,}" &&
   $partition == 2 && $parent =~ ^(mmcblk[0-9]+|sd[a-z]+|vd[a-z]+|nvme[0-9]+n[0-9]+)$ ]] || {
    echo "Unexpected root device: $root_device; no disk changes made." >&2
    exit 1
}
status=0
result=$(growpart "/dev/$parent" "$partition" 2>&1) || status=$?
printf '%s\n' "$result"
if (( status != 0 )) && [[ $result != NOCHANGE:* ]]; then
    exit "$status"
fi
resize2fs "$root_device"
install -d -m 755 /var/lib/rpi4
touch /var/lib/rpi4/root-expanded
